<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_usage"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/status_service"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_service_off"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/status_notify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_notify_off"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/status_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/level_1"
            android:textSize="14sp"
            android:textColor="@color/brand_dark"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_accessibility"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_enable_accessibility" />

            <Button
                android:id="@+id/btn_notify"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/btn_enable_notify" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_open_target"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_open_target" />

            <Button
                android:id="@+id/btn_settings"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/label_dump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="界面抓取（调选择器用）"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_dump"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_dump" />

            <Button
                android:id="@+id/btn_copy"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_copy" />
        </LinearLayout>

        <TextView
            android:id="@+id/label_probe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="链路自检：读消息 → 填草稿（不会发送）"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_probe"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_probe" />

            <Button
                android:id="@+id/btn_generate"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/btn_generate" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_delayed"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_delayed" />

            <Button
                android:id="@+id/btn_next"
                style="@style/GhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/btn_next" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_delayed"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_batch"
            style="@style/GhostButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_batch_default" />

        <TextView
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:background="@color/surface"
            android:padding="12dp"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
