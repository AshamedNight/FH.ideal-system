<resources>
    <string name="app_name">AutoReply</string>
    <string name="title_settings">设置</string>

    <string name="service_label">AutoReply 界面读取</string>
    <string name="service_notify_label">AutoReply 消息通知读取</string>
    <!--
      输入法的名字要对别的 App "隐身"。

      任何 App 都能用 InputMethodManager.getEnabledInputMethodList()（无需权限）
      枚举设备上启用的输入法，再用 InputMethodInfo.loadLabel() 读到这个名字。
      也就是说：一个叫「AutoReply 输入」的输入法，等于在系统里挂了个招牌，
      交点 App 想查"这人是不是装了自动回复工具"，看一眼默认输入法就够了 ——
      比分析行为省事得多。

      所以这里用中性名。注意**不是**为了骗平台，而是不让它变成一个
      一眼可见的信号：名字本身不承担任何功能，起个普通名字不损失什么。
    -->
    <string name="ime_label">简输入</string>
    <string name="ime_subtype_label">简输入</string>
    <string name="accessibility_desc">在你开启自动回复后，读取当前聊天界面的消息内容并填入回复草稿。程序不会替你点发送，草稿是否发出始终由你决定。</string>

    <string name="status_service_off">读屏服务：未开启</string>
    <string name="status_service_on">读屏服务：已连接</string>
    <string name="status_notify_off">通知读取：未授权</string>
    <string name="status_notify_on">通知读取：已授权</string>

    <string name="btn_enable_accessibility">开启读屏</string>
    <string name="btn_enable_notify">开启通知读取</string>
    <string name="btn_open_target">打开目标应用</string>
    <string name="btn_ime">切换输入法（同城 / 他趣必需）</string>
    <string name="btn_dump">抓取当前界面</string>
    <string name="btn_copy">复制结果</string>
    <string name="btn_probe">试填（复读原文）</string>
    <string name="btn_generate">生成并填入</string>
    <string name="btn_next">下一个未读</string>
    <string name="btn_delayed">延时 5 秒填</string>
    <string name="btn_batch_default">连点（每条你点发送）</string>
    <string name="btn_batch">连点 %1$d 个（每条你点发送）</string>
    <string name="btn_batch_stop">停止连点</string>
    <string name="hint_delayed">「延时填」倒计时 5 秒后执行 —— 这段时间里切回目标 App、点一下输入框，让光标留在里面。切回来点按钮会让输入焦点丢失，这是本机唯一能保住焦点的方式。「下一个未读」会切换会话。</string>
    <string name="btn_settings">设置</string>
    <string name="btn_stop">停止</string>

    <string name="hint_usage">用法：先开启读屏与通知读取，再在设置里填好模型和人设。收到新消息后，程序会把回复草稿填进输入框，由你点发送。</string>
    <string name="hint_no_dump">还没抓到界面：屏幕上没有可读的 App 窗口。先切到目标 App 的聊天页，停留 2 秒以上让它稳定，再切回来点「抓取当前界面」。若那个 App 还没登记包名，去 设置 → 目标应用包名 加一行。</string>

    <string name="level_0">L0 只填不发</string>
    <string name="level_1">L1 通知驱动（推荐）</string>
    <string name="level_2">L2 列表轮询（不建议）</string>
    <string name="level_2_warning">L2 会反复扫会话列表并逐个点开，是自动化特征最明显的行为，显著提高账号被限制的概率。确认要继续吗？</string>
</resources>
