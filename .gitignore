*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.keystore
*.p12
testkey.p12

# 签名密钥与它的 base64 副本：绝不入库。
# 私钥一旦进了 git 历史，即使后来删掉也能从历史里捞出来。
_signing/
*.b64

# ---- 旧项目参考区（_legacy）里的运行时产物 ----
# 这些是跑起来才生成的：数据库、WAL、日志、抓包记录、缓存。
# 进仓库只会让 clone 变慢，而且可能含聊天内容，不该跟着代码走。
_legacy/gateway/_runtime/
__pycache__/
*.pyc
_legacy/gateway/__pycache__/
_legacy/gateway/outbox/
_legacy/gateway/recordings/
*.db
*.db-shm
*.db-wal
*.jsonl
*.log

# 真机 dump 里有真实聊天内容，绝不进仓库。
# 用 /*.txt 覆盖根目录所有 txt：这个项目的源码里不会有 .txt，
# 而 dump 文件名五花八门（dump.txt、pkg=xxx.txt、新dump.txt…），逐个列必然漏。
/*.txt
/dumps/

# 人设与话术的原始素材（聊天示范、旧话术草稿）。内容已经提炼进 人设-小陈大夫.json，
# 留在这里只是为了将来想改时有个参照 —— 里面同样有真实聊天内容，不入库。
/素材/

# 从手机导出的安装包（体积大，不入库）
_apk/
